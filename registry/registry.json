{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "recommand",
  "homepage": "https://github.com/recommand/recommand-core",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "description": "The theme contract with neutral defaults, and the state variants the components use. Import both after Tailwind and tw-animate-css, then your theme.",
      "dependencies": [
        "tw-animate-css@^1.4.0"
      ],
      "files": [
        {
          "path": "styles/theme-default.css",
          "type": "registry:file",
          "target": "styles/recommand-ui/theme-default.css"
        },
        {
          "path": "styles/variants.css",
          "type": "registry:file",
          "target": "styles/recommand-ui/variants.css"
        }
      ]
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "dependencies": [
        "clsx@2.1.1",
        "tailwind-merge@^3.7.0"
      ],
      "files": [
        {
          "path": "lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "use-mobile",
      "type": "registry:hook",
      "files": [
